{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/_next/static/:path*", "destination": "https://thebeaconstudio.co.ke/_next/static/:path*" },
    { "source": "/_next/image", "destination": "https://thebeaconstudio.co.ke/_next/image" },
    { "source": "/products/:slug/:file(.+\\.(?:jpg|jpeg|png|webp|avif|svg))", "destination": "https://thebeaconstudio.co.ke/products/:slug/:file" },
    { "source": "/work/:file(.+\\.(?:jpg|jpeg|png|webp|avif|svg))", "destination": "https://thebeaconstudio.co.ke/work/:file" },
    { "source": "/brand/:file(.+\\.(?:jpg|jpeg|png|webp|avif|svg|ico))", "destination": "https://thebeaconstudio.co.ke/brand/:file" },
    { "source": "/images/:path*", "destination": "https://thebeaconstudio.co.ke/images/:path*" },
    { "source": "/favicon.ico", "destination": "https://thebeaconstudio.co.ke/favicon.ico" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
      { "key": "Timing-Allow-Origin", "value": "*" }
    ]},
    { "source": "/_next/static/(.*)", "headers": [{ "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(products|work|brand|images)/(.*)", "headers": [{ "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/_next/image", "headers": [{ "key": "CDN-Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/favicon.ico", "headers": [{ "key": "CDN-Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
