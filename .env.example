# Optional: OpenAI for Glow assistant + brief helper (falls back to on-site KB without a key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Admin dashboard password / PIN for /admin (required)
ADMIN_PASSWORD=change-me

# Client portal token signing (magic links + session cookies). Required in production.
# Falls back to ADMIN_PASSWORD in local/dev if unset.
PORTAL_SECRET=change-me-portal-secret

# Analytics persist to data/analytics.json via POST /api/analytics
# Future: PostHog / Vercel Analytics — see INTEGRATIONS.md

# ── Resend (contact, subscribe, booking, portal OTP) ─────────────────
# Leave unset: forms still save locally; portal shows OTP on-screen.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Stripe (deposit = 30% of tier floor) ─────────────────────────────
# Leave unset to show “coming soon” + mailto / book fallbacks.
# Live Checkout needs STRIPE_SECRET_KEY. Optional Price IDs should match 30% deposits.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SPRINT_DEPOSIT=
STRIPE_PRICE_PRODUCT_DEPOSIT=
STRIPE_PRICE_RETAINER_DEPOSIT=

# ── M-Pesa Daraja STK Push (sandbox or production) ───────────────────
# 1. Create an app at https://developer.safaricom.co.ke/
# 2. Copy Consumer Key / Secret; use Lipa Na M-Pesa Online sandbox shortcode + passkey
# 3. Set MPESA_CALLBACK_URL to a public HTTPS URL pointing at:
#    https://YOUR_DOMAIN/api/payments/mpesa/callback
#    (use ngrok or similar for local sandbox testing)
# 4. MPESA_ENV=sandbox | production
# 5. Optional MPESA_KES_RATE (default 130) converts USD tier floors → KES for STK
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
# MPESA_KES_RATE=130

# Documented in README / INTEGRATIONS.md: phone number is edited in src/data/site.ts (phone / phoneDisplay).
