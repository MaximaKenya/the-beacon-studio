# Durable storage. When set, contacts, intakes, bookings, projects, messages,
# reviews (inside projects), portal threads, payments, and the other data/*.json
# documents are stored in Postgres. Neon free tier: use the pooled connection
# string (hostname contains -pooler) and sslmode=require. TLS is required for
# any non-local host. When unset, the app uses JSON files in data/ (local dev).
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Client-side pool size for one Heroku Node 22 dyno (default 5).
# PG_POOL_MAX=5
# Leave unset for Neon (public certificates are verified). Set false only if the
# provider uses a private CA.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional: OpenAI for Glow assistant + brief helper (falls back to on-site KB without a key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Beacon AI chat (POST /api/ai/chat) calls Groq's OpenAI-compatible API:
# https://api.groq.com/openai/v1/chat/completions
# Without GROQ_API_KEY the widget still opens and shows a WhatsApp fallback.
# Default model is llama-3.3-70b-versatile. Groq retired that id for free and
# developer tiers on 2026-08-16 (enterprise committed-spend accounts still have it).
# If the default is rejected, the route retries openai/gpt-oss-120b once.
# Set GROQ_MODEL to pin a model and skip that retry.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Admin dashboard password for /admin (required). On Heroku set this as a config var.
# Log in at https://YOUR_APP/admin with this value. The page is not linked in the public menu.
ADMIN_PASSWORD=change-me

# Submissions (contact, intake, booking, reviews, portal messages) use the storage
# adapter above. With DATABASE_URL unset they land in data/*.json, which Heroku wipes
# on restart. Set RESEND_API_KEY so each submission and each admin reply is also emailed.

# Client portal token signing (magic links + session cookies). Required in production.
# Falls back to ADMIN_PASSWORD in local/dev if unset.
PORTAL_SECRET=change-me-portal-secret

# Analytics persist to data/analytics.json via POST /api/analytics
# Future: PostHog / Vercel Analytics — see INTEGRATIONS.md

# ── Resend (mailbox, contact, subscribe, booking, portal OTP) ────────
# Leave unset: forms still save; /admin mailbox shows "Email not configured".
# RESEND_FROM_EMAIL is the verified sender, e.g. hello@<domain>
# RESEND_REPLY_TO is where client replies should land (often the same address).
# RESEND_WEBHOOK_SECRET verifies POST /api/email/inbound (svix / webhook signature).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# ── Paystack (primary deposit checkout) ──────────────────────────────
# Prices stay in USD. Checkout charges KES (M-Pesa + card) or USD card.
# PAYSTACK_USD_KES_RATE overrides the KES equivalent (default 130).
# Webhook: https://<domain>/api/paystack/webhook
# Signed with PAYSTACK_SECRET_KEY (header x-paystack-signature, HMAC SHA512).
# Beacon Studio charges use reference BS-<id> and metadata.app=beacon-studio.
# Other products are forwarded with the raw body and the original signature.
# PAYSTACK_FORWARD_CONFIRENT=https://confirent.co.ke/api/paystack/webhook
# PAYSTACK_FORWARD_CADENCEAPP=
# PAYSTACK_FORWARD_LOOKFINESSE=
# PAYSTACK_FORWARD_CONFILEARN=
# PAYSTACK_FORWARD_CONFITRADE=
# PAYSTACK_FORWARD_TRIVIAYARD=
# PAYSTACK_FORWARD_CONVORIA=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_USD_KES_RATE=130

# Ready-made automations. Heroku Scheduler: POST /api/automations/tick
# hourly with header Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Optional SMS. Without these, reminders use email and a wa.me link.
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=

# ── Stripe (optional; hidden in checkout unless the secret is set) ──
# Live Checkout needs STRIPE_SECRET_KEY. Optional Price IDs should match 30% deposits.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SPRINT_DEPOSIT=
STRIPE_PRICE_PRODUCT_DEPOSIT=
STRIPE_PRICE_RETAINER_DEPOSIT=

# ── M-Pesa Daraja STK Push (sandbox or production) ───────────────────
# 1. Create an app at https://developer.safaricom.co.ke/
# 2. Copy Consumer Key / Secret; use Lipa Na M-Pesa Online sandbox shortcode + passkey
# 3. Set MPESA_CALLBACK_URL to a public HTTPS URL pointing at:
#    https://YOUR_DOMAIN/api/payments/mpesa/callback
#    (use ngrok or similar for local sandbox testing)
# 4. MPESA_ENV=sandbox | production
# 5. Optional MPESA_KES_RATE (default 130) converts USD tier floors → KES for STK
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
# MPESA_KES_RATE=130

# Phone is set in src/data/site.ts: +254706397373, display 0706 397 373, WhatsApp https://wa.me/254706397373.
